# Kernel configuration of the enchilada image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# The sheng set without the board's GPU, display, boot progress and Data ramdisk parts. The UFS root uses the
# NativeUfs copy in drivers/NativeUfs, the NativeVirtioBlock storage bindings and verified root archive built by
# scripts/build-enchilada-storage.py and build-enchilada-verified-root.py, and the sheng PMGR stub the original AMFI needs.
# NATIVE_LEGACY_DISPLAY links the CPU-rendered display, HID input and keystore archive of
# scripts/build-native-legacy-display.py; NATIVE_MOBILE_DISPLAY (the prototype) and NATIVE_ADRENO (A740 only) stay off.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# NativeDwc3 (SDM845 DWC3 USB device-mode probe, scripts/build-enchilada-dwc3.py) is force-loaded into the kernel. The
# driver is default-off: it maps and reads nothing unless the boot argument native-dwc3-probe=1 is present. Its
# IOKit personality is added unconditionally by patches/xnu/zzv-native-dwc3-personality.patch.
# The touch bring-up (scripts/build-enchilada-touch.py, default off: enchilada-touch=<stage>) is force-loaded as well; it defines the
# touch snapshot NativeHidInput reads. The CPU clock probe (scripts/build-enchilada-cpufreq.py, default off: enchilada-cpufreq=<n>) too.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/enchilada-dwc3/libNativeDwc3.a -Wl,-force_load,{tree}/build/enchilada-touch/libEnchiladaTouch.a -Wl,-force_load,{tree}/build/enchilada-cpufreq/libEnchiladaCpuFreq.a"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libVirtioMmioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
# Two compositions were measured.  k124-k133 used the union one, which mounts SystemOS over "/":
# the cache file then sits on the same mount as the process root, so shared_region_map_and_slide_setup's
# "root volume or preboot cryptex" check would pass -- but dyld never gets that far.  The cryptex probe
# reports the file as present and readable through the union root:
#   /System/Library/Caches/com.apple.dyld                            -> 0, VDIR
#   /System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64   -> 0, VREG
# Yet on every union kernel launchd ends at the same place: two shared_region_check_np refusals and no
# call to shared_region_map_and_slide_2_np.  dyld reaches that syscall only from mapSplitCacheSystemWide,
# whose first step is openat(cacheDirFD, "dyld_shared_cache_arm64") on a directory it opened itself.
# A directory-fd relative lookup runs through union_lookup with the union root vnode as the starting
# point, which is the one step the absolute-path probe does not exercise -- so the union composition
# leaves the cache reachable by vnode_lookup and still unreachable by dyld.
# The non-union composition puts SystemOS at /private/preboot instead, and the kernel hands dyld
# DYLD_SHARED_CACHE_DIR=/private/preboot/System/Library/Caches/com.apple.dyld in its environment.
# That path lives on an ordinary APFS mount, so the openat that dyld performs is a normal one.  The file
# is then on a different mount than the process root, which shared_region_map_and_slide_setup refuses
# with EPERM -- unless XNU_OWNER_CACHE_CARRIER accepts it, which is what offline-owner-cache-carrier.patch
# exists for (its positive checkpoint is exactly stage=6, dyld_flags bit 3 set, accepts=53, and
# shared_region_map_and_slide_2_np returning 0).  That is the configuration below.
CONFIG_XNU_OWNER_UNION_SYSTEMOS=n
CONFIG_XNU_OWNER_CACHE_CARRIER=y
# The owner boot manifest publishes boot-manifest-hash/owner-boot-manifest-domain into /chosen. The shared
# implementation does that by hashing the OS (47,481,664 B) and SystemOS (25,805,344 B) manifest envelopes with
# SHA384 first. On the real OnePlus 6 (SDM845) that is ~73 MiB of *software* SHA384 (device accelerated
# crypto: 0) in the prelinked corecrypto kext, and the first device bring-up proved it deadlocks there
# (boot_log_rounds stuck at 1, enchilada-deadline timer never re-fires): init pid 1 spins in SHA384_Update <-
# authenticatesVolume <- native_ufs_block_authenticates <- verifiedVolumeQuery with interrupts masked.
# patches/xnu-device/offline-owner-boot-manifest.patch therefore reads /chosen first and treats an identity the
# payload device tree already carries as success. The ADT supplies that identity (kernel.macho.adt
# /chosen/boot-manifest-hash), which is where Apple's own boot loader puts it, so mount(8) reads
# kern.bootobjectspath instead of failing with "failed to get boot-manifest-hash" and exiting 66 -- which
# launchd treats as a fatal mount-phase-1 failure and panics on.
# On is required for XNU_OWNER_DATA_MOUNT (offline-owner-systemos-mount.patch #errors otherwise), and the
# writable Data volume is what /private/var needs: with only the read-only OS volume, tzinit exits 30 on
# /var/db/timezone/zoneinfo and launchd panics with "Boot task failed: tzinit".
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
# Must equal the volume UUID of the Data seed on the payload (scripts/make-data-seed-linux.py --volume-uuid, run
# by .github/workflows/data-seed.yml). A mismatch is not a visible error: native_ram_block_volume_seed returns
# ENOENT and load_init_program panics "offline scratch Data mount failed" just before launchd.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="18AB5557-DC2D-469B-8758-855E60F5B0DF"
CONFIG_XNU_BOOT_PROGRESS=y
