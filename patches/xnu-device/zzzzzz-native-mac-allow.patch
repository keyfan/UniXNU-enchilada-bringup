index 91376bf..7d4fe33 100644
--- a/security/mac_vfs.c
+++ b/security/mac_vfs.c
@@ -88,10 +88,94 @@
 #include <miscfs/devfs/fdesc.h>
 
 #include <security/mac_internal.h>
+#include <pexpert/pexpert.h>
 
 /* convert {R,W,X}_OK values to V{READ,WRITE,EXEC} */
 #define ACCESS_MODE_TO_VNODE_MASK(m)    (m << 6)
 
+/*
+ * The two dylibs that sit outside the dyld shared cache are handed to processes
+ * from the SystemOS volume (see the namei redirect), yet every immutable
+ * sandbox profile denies /private/preboot because a stock system never reads
+ * the system tree from there.  Answer "allowed" in the kernel for vnode checks
+ * that land on the SystemOS volume -- a volume only this kernel mounts -- so
+ * the policy module is not consulted for those lookups.  Reads and metadata
+ * only: write, create, unlink, setattr, exec and signature hooks stay enforced.
+ *
+ * "sheng-mac-allow=0" turns it off for an A/B run.
+ */
+extern volatile dev_t native_owner_cache_mounted_device __attribute__((weak_import));
+
+volatile unsigned int native_owner_mac_allow_hits = 0;
+
+/*
+ * This runs on the lookup path, so remember the verdict per mount instead of
+ * asking the device layer every time.  The process root and SystemOS are the
+ * only mounts that ever matter here.
+ */
+#define NATIVE_MAC_ALLOW_SLOTS 8
+static mount_t native_mac_allow_mount[NATIVE_MAC_ALLOW_SLOTS];
+static int native_mac_allow_verdict[NATIVE_MAC_ALLOW_SLOTS];
+
+/* Called from security/mac_file.c as well, so this one is not static. */
+int
+native_owner_mac_allow(struct vnode *vp);
+
+static int
+native_mac_allow_slot(mount_t mnt)
+{
+	return ((int)(((uintptr_t)mnt >> 4) & (NATIVE_MAC_ALLOW_SLOTS - 1)));
+}
+
+int
+native_owner_mac_allow(struct vnode *vp)
+{
+	static int state = -1;
+	dev_t mounted;
+	mount_t mnt;
+	vnode_t devvp;
+	dev_t dev;
+	int slot;
+
+	if (state < 0) {
+		uint64_t enabled = 1;
+		if (!PE_parse_boot_argn("sheng-mac-allow", &enabled, sizeof(enabled))) {
+			enabled = 1;
+		}
+		state = (enabled != 0) ? 1 : 0;
+	}
+	if (state == 0 || vp == NULLVP) {
+		return 0;
+	}
+	mounted = native_owner_cache_mounted_device;
+	if (mounted == NODEV) {
+		return 0;
+	}
+	mnt = vnode_mount(vp);
+	if (mnt == NULL) {
+		return 0;
+	}
+	slot = native_mac_allow_slot(mnt);
+	if (native_mac_allow_mount[slot] == mnt) {
+		if (native_mac_allow_verdict[slot] != 0) {
+			native_owner_mac_allow_hits++;
+		}
+		return native_mac_allow_verdict[slot];
+	}
+	devvp = vfs_devvp(mnt);
+	if (devvp == NULL) {
+		return 0;
+	}
+	dev = vnode_specrdev(devvp);
+	vnode_put(devvp);
+	native_mac_allow_verdict[slot] = (dev == mounted) ? 1 : 0;
+	native_mac_allow_mount[slot] = mnt;
+	if (native_mac_allow_verdict[slot] != 0) {
+		native_owner_mac_allow_hits++;
+	}
+	return native_mac_allow_verdict[slot];
+}
+
 
