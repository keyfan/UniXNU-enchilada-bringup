Allow read-side MAC checks on the SystemOS volume

The two dylibs outside the dyld shared cache are served from the SystemOS
volume, but every immutable sandbox profile denies /private/preboot, so the
processes that need them are refused the very paths the redirect hands out.
The kernel answers "allowed" for read and metadata checks on that volume -- one
only this kernel ever mounts -- and leaves write, create, unlink, setattr, exec
and signature checks untouched.

The vnode hooks cover file-read-data and file-read-metadata; the mapping check
the sandbox reports as file-map-executable arrives through mac_file_check_mmap
with a fileglob instead of a vnode, so it resolves the vnode and asks the same
question.  kernel-153 measured what was left: K allow=7246343 with every
read-side deny gone and all of the remaining 203 denies file-map-executable on
the same two paths.

diff --git a/security/mac_file.c b/security/mac_file.c
index 4019395..671fa9d 100644
--- a/security/mac_file.c
+++ b/security/mac_file.c
@@ -46,6 +46,11 @@
 #include <sys/file_internal.h>
 
 #include <security/mac_internal.h>
+#include <pexpert/pexpert.h>
+
+/* security/mac_vfs.c answers read-side vnode checks on the SystemOS
+ * volume; see native_owner_mac_allow there. */
+extern int native_owner_mac_allow(struct vnode *vp);
 
 int
 mac_file_check_create(struct ucred *cred)
@@ -177,6 +182,19 @@ mac_file_check_mmap(struct ucred *cred, struct fileglob *fg, int prot,
 	int error;
 	int maxp;
 
+	/* The cached-out libobjc trampolines are mapped executable straight from the
+	 * SystemOS volume, so answer the mapping check the same way the read-side
+	 * vnode checks are answered.  A/B: sheng-mac-allow=0. */
+	if (fg != NULL && FILEGLOB_DTYPE(fg) == DTYPE_VNODE) {
+		struct vnode *mvp = (struct vnode *)fg_get_data(fg);
+		if (mvp != NULL && vnode_getwithref(mvp) == 0) {
+			int allowed = native_owner_mac_allow(mvp);
+			vnode_put(mvp);
+			if (allowed) {
+				return 0;
+			}
+		}
+	}
 	maxp = *maxprot;
 	MAC_CHECK(file_check_mmap, cred, fg, NULL, prot, flags, offset, &maxp);
 	if ((maxp | *maxprot) != *maxprot) {
