@@ -2740,6 +2740,8 @@ _shared_region_map_and_slide(
 	error = shared_region_map_and_slide_setup(p, files_count,
 	    files, mappings_count, mappings,
 	    &sr_file_mappings, &shared_region, rdir_vp);
+	printf("NATIVE_SR: setup error=%d files=%u mappings=%u\n",
+	    error, files_count, mappings_count);
 	if (error != 0) {
 		vnode_put(rdir_vp);
 		return error;
@@ -2900,6 +2902,9 @@ shared_region_map_and_slide_2_np(
 	files_count = uap->files_count;
 	mappings_count = uap->mappings_count;
 
+	printf("NATIVE_SR: map_and_slide_2 files=%u mappings=%u p_comm=%s\n",
+	    files_count, mappings_count, p->p_comm);
+
 	if (files_count == 0) {
 		SHARED_REGION_TRACE_INFO(
 			("shared_region: %p [%d(%s)] map(): "
